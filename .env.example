# Inspectly environment variables.
# Copy to .env.local for local dev, or set these in the Vercel dashboard
# scoped per environment (Production / Preview / staging). See MIGRATION.md.

# --- Database (Neon) ---
# Runtime queries use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DDL / drizzle migrations use the DIRECT (unpooled) connection string.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth ---
# Secret used to sign JWT session cookies. Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- AI ---
# Direct OpenAI API key (replaces the Replit AI proxy).
OPENAI_API_KEY="sk-..."

# --- File storage (Vercel Blob) ---
# Injected by connecting a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# NODE_ENV is set automatically by Vercel (production on deploys).
#
# The following Replit-era variables are NO LONGER USED — delete them:
#   AI_INTEGRATIONS_OPENAI_API_KEY
#   AI_INTEGRATIONS_OPENAI_BASE_URL
#   PORT
#   REPL_ID
#   ISSUER_URL
